                "name": "customer-code",
                "value": ""
              },
              {
                "name": "logged-in-user-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This web service allows an external application to create a draft expense report."
        },
