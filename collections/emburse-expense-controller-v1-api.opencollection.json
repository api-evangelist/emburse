      "items": [
        {
          "info": {
            "name": "Get list of reports summary by expense owner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://service.chromeriver.com/v1/expense-reports",
            "headers": [
              {
                "name": "chain-id",
                "value": ""
              },
              {
                "name": "customer-code",
                "value": ""
              },
              {
                "name": "logged-in-user-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "expenseOwnerId",
                "value": "",
                "type": "query",
                "description": "Unique ID for the owner of the expense report. Either expenseOwnerId or (header) logged-in-user-id is required."
              }
            ]
          },
          "docs": "This web service allows an external application to fetch a list of report summaries by owner. This excludes deleted reports of the owner"
        },
        {
