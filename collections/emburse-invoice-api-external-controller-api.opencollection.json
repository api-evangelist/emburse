          "info": {
            "name": "Returns invoices by InvoiceFilter.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://service.chromeriver.com/v1/invoice-api/invoices",
            "headers": [
              {
                "name": "chain-id",
                "value": ""
              },
              {
                "name": "customer-code",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Date filtering expects RFC3339 / ISO-8601 timestamps (UTC recommended).\nPreferred examples:\n  - 2022-12-01T00:00:00Z\n  - 2022-12-01T00:00:00+00:00\nLegacy format currently accepted for backward compatibility (discouraged):\n  - 2022-12-01T00:00:00+0000"
        },
